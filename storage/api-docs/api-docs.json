                                                            "properties": {
                                                                "id": {
                                                                    "type": "integer"
                                                                },
                                                                "order_number": {
                                                                    "type": "integer"
                                                                },
                                                                "type": {
                                                                    "type": "string"
                                                                },
                                                                "status": {
                                                                    "type": "string"
