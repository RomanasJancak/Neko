        "/api/workloads/calendar": {
            "get": {
                "tags": [
                    "Workloads"
                ],
                "summary": "Get workload calendar data",
                "operationId": "ac0041ebf0de6e4a9d1a2a32a57e63a1",
                "parameters": [
                    {
                        "name": "year",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "month",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "view",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "monthly",
                                "weekly"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                },
                "security": [
                    {
                        "sanctum_auth": []
                    }
                ]
            }
        },
        "/api/workloads/{workload}/assign-bike": {
            "post": {
                "tags": [
                    "Workloads"
                ],
                "summary": "Assign or swap a bike for a workload",
                "operationId": "187ce74f5eb6a4eee2dd224cd72da8af",
                "parameters": [
                    {
                        "name": "workload",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "bike_id"
                                ],
                                "properties": {
                                    "bike_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Bike swapped successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum_auth": []
                    }
                ]
            }
        }
    },
